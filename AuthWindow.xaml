<Window x:Class="CrucianGame.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrucianGame"
        mc:Ignorable="d"
        Title="Мой карасик — Авторизация" Height="420" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="AuthTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="AuthPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Background="#E3F2FD">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1565C0" Padding="15,15">
            <TextBlock Text="🐟 Мой карасик" FontSize="24" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Поле логина -->
        <StackPanel Grid.Row="1" Margin="30,20,30,0">
            <TextBlock Text="Имя пользователя" FontSize="13" Foreground="#555" Margin="0,0,0,3"/>
            <TextBox x:Name="UsernameBox" Style="{StaticResource AuthTextBox}" MaxLength="50"/>
        </StackPanel>

        <!-- Поле пароля -->
        <StackPanel Grid.Row="2" Margin="30,0,30,0">
            <TextBlock Text="Пароль" FontSize="13" Foreground="#555" Margin="0,0,0,3"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource AuthPasswordBox}"/>
        </StackPanel>

        <!-- Сообщение об ошибке -->
        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="30,0,30,0"
                   Foreground="#D32F2F" FontSize="13" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <!-- Кнопка действия (Войти / Зарегистрироваться) -->
        <Button x:Name="ActionButton" Grid.Row="4" Margin="30,10,30,0"
                Height="40" FontSize="16" FontWeight="Bold"
                Background="#1565C0" Foreground="White"
                Cursor="Hand" BorderThickness="0"
                Click="OnActionButtonClick"/>

        <!-- Ссылка переключения режима -->
        <TextBlock x:Name="ToggleModeText" Grid.Row="5" Margin="30,10,30,0"
                   Foreground="#1565C0" FontSize="13"
                   HorizontalAlignment="Center" Cursor="Hand"
                   TextDecorations="Underline"
                   MouseDown="OnToggleModeClick"/>

        <!-- Нижняя подпись -->
        <TextBlock Grid.Row="6" Text="v1.0" FontSize="11"
                   Foreground="#90CAF9" VerticalAlignment="Bottom"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
    </Grid>
</Window>
