<Window x:Class="CrucianGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrucianGame"
        mc:Ignorable="d"
        Title="Мой карасик" Height="650" Width="500" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <!-- Стиль для кнопок шляп в магазине -->
        <Style x:Key="HatButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- Стиль для рамок шляп -->
        <Style x:Key="HatBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <!-- Стиль для кликабельной кнопки карася (без контуров) -->
        <Style x:Key="CrucianButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          RecognizesAccessKey="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#E3F2FD">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- строка статуса -->
            <RowDefinition Height="*"/>      <!-- область карася -->
            <RowDefinition Height="Auto"/>   <!-- магазин шляп -->
            <RowDefinition Height="Auto"/>   <!-- статистика -->
        </Grid.RowDefinitions>

        <!-- ========== ВЕРХНЯЯ ПАНЕЛЬ СТАТУСА ========== -->
        <Border Grid.Row="0" Background="#1565C0" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Звание -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="RankEmoji" Text="" FontSize="28" Margin="0,0,8,0"/>
                    <TextBlock x:Name="RankNameText" Text="Икринка" FontSize="22" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Валюта -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="" FontSize="24" Margin="0,0,5,0"/>
                    <TextBlock x:Name="CurrencyText" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="#FFD700" VerticalAlignment="Center"/>
                    <TextBlock Text=" червячков" FontSize="16" Foreground="#90CAF9"
                               VerticalAlignment="Center" Margin="3,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== ЦЕНТРАЛЬНАЯ ОБЛАСТЬ — КАРАСЬ ========== -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Контейнер для карася со шляпой (анимируется вместе) -->
            <Grid x:Name="CrucianContainer" Grid.Row="0" Width="250" Height="250" Margin="0,10,0,0">
                <!-- Кликабельное изображение карася -->
                <Button x:Name="CrucianButton" Click="OnCrucianClick"
                        Style="{StaticResource CrucianButtonStyle}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="CrucianImage" Source="assets/player_crucian.png"
                           Width="200" Height="200" Stretch="Uniform"/>
                </Button>

                <!-- Шляпа поверх карася (изначально скрыта) -->
                <Image x:Name="HatOverlayImage"
                       Width="80" Height="80"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,10,0,0"
                       Stretch="Uniform"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>

            <!-- Подпись под карасём -->
            <TextBlock Grid.Row="1" Text="Нажми на карася!"
                       FontSize="16" FontStyle="Italic"
                       Foreground="#64B5F6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </Grid>

        <!-- ========== МАГАЗИН ШЛЯП ========== -->
        <Border Grid.Row="2" Background="White" Padding="15,10" BorderBrush="#ccc" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="МАГАЗИН ШЛЯП" FontSize="18" FontWeight="Bold"
                           Foreground="#1565C0" Margin="0,0,0,10"/>

                <!-- Список шляп (WrapPanel для переноса) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HatsPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========== СТАТИСТИКА ========== -->
        <Border Grid.Row="3" Background="#BBDEFB" Padding="15,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Всего кликов: " FontSize="13" Foreground="#555"/>
                <TextBlock x:Name="TotalClicksText" Text="0" FontSize="13" FontWeight="Bold" Foreground="#333"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
