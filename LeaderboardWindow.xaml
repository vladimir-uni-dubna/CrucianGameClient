<Window x:Class="CrucianGame.LeaderboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrucianGame"
        mc:Ignorable="d"
        Title="Таблица лидеров" Height="450" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Background="#E3F2FD">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1565C0" Padding="15,10">
            <TextBlock Text="ТОП-20 ИГРОКОВ" FontSize="20" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Список лидеров -->
        <ScrollViewer Grid.Row="1" Margin="10,10,10,0">
            <ItemsControl x:Name="LeaderboardList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" Margin="0,0,0,5" Padding="10,8"
                                CornerRadius="8" BorderBrush="#90CAF9" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Место -->
                                <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#1565C0"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <!-- Имя и ранг -->
                                <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="Bold"
                                               Foreground="#333"/>
                                    <TextBlock Text="{Binding RankName}" FontSize="12"
                                               Foreground="#666" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Валюта -->
                                <TextBlock Grid.Column="2" Text="{Binding CurrencyDisplay}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#FFD700"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="#BBDEFB" Padding="10,8">
            <Button x:Name="CloseButton" Content="Закрыть"
                    Width="120" Height="35" FontSize="14" FontWeight="Bold"
                    Background="#1565C0" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="OnCloseClick"
                    HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
